###############################################################################
# Seedhe Maut Player — server-side configuration
#
# Copy to `.env.local` and fill in. NONE of these are prefixed NEXT_PUBLIC_,
# so they are never bundled into the browser build.
#   cp .env.example .env.local
###############################################################################

# ---------------------------------------------------------------- Spotify ---
# https://developer.spotify.com/dashboard -> Create app
# Used for metadata, album grouping and official artwork (Client Credentials
# flow — no user login, no playback).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Seedhe Maut on Spotify. Leave as-is, or clear it to resolve by name instead.
SPOTIFY_ARTIST_ID=2oBG74gAocPMFv6Ij9ykdo

# ISO country code used for track availability.
SPOTIFY_MARKET=IN

# ---------------------------------------------------------------- YouTube ---
# https://console.cloud.google.com -> enable "YouTube Data API v3" -> API key
# Used to find the official video id for each song. Playback happens in the
# official YouTube IFrame player on the client.
YOUTUBE_API_KEY=

# Official channel id (starts with UC...). Strongly recommended: enumerating a
# channel's uploads costs 1 quota unit per 50 videos, while search.list costs
# 100 units per call. Leave blank to auto-resolve by name (one search call).
YOUTUBE_CHANNEL_ID=

# Alternative to the id above — the channel @handle. Resolved with channels.list
# (1 unit) so the often-restricted search.list is never needed.
YOUTUBE_CHANNEL_HANDLE=@SeedheMaut

# Optional: a specific playlist to draw the catalogue from instead of scanning
# the whole channel. Wins over CHANNEL_ID/CHANNEL_HANDLE when set. Every video
# in it is trusted as a real song — no trailer/vlog/duration filtering, since
# a hand-picked playlist is already curated.
YOUTUBE_PLAYLIST_ID=

# Allow falling back to the expensive search.list when a song has no match in
# the channel uploads. Off by default to protect your 10,000 units/day quota.
YOUTUBE_ALLOW_SEARCH=false
YOUTUBE_MAX_SEARCH_FALLBACKS=0

# ----------------------------------------------------------------- Genius ---
# https://genius.com/api-clients -> New API Client -> "Client Access Token"
# Optional: powers the Lyrics panel via Genius's official embed (their
# sanctioned <div>+<script> snippet for third-party display — we never read or
# render raw lyric text ourselves). Leave blank and the panel just says
# lyrics aren't set up yet; nothing else in the app depends on this.
GENIUS_ACCESS_TOKEN=

# ------------------------------------------------------------------ General --
ARTIST_NAME=Seedhe Maut

# How long the merged catalog is cached in memory (seconds). Default 6 hours.
CACHE_TTL_SECONDS=21600

# Per-IP rate limiting.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# CORS. Empty = same-origin only (recommended). Use a comma-separated list of
# origins, or "*" to allow any. Example:
#   ALLOWED_ORIGINS=https://yoursite.com,http://localhost:3000
ALLOWED_ORIGINS=
